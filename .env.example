# ── Locitra Environment Variables Reference ──────────────────────────────────
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# ── Site Configuration ────────────────────────────────────────────────────────
# Public site URL — used for CSRF origin validation and canonical URLs
NEXT_PUBLIC_SITE_URL=https://www.locitra.com

# ── Google Analytics 4 ────────────────────────────────────────────────────────
# Measurement ID from Google Analytics (starts with G-)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ── Brevo (Sendinblue) Email Service ─────────────────────────────────────────
# Create API key at: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your_brevo_api_key_here
# List ID from Brevo Contacts > Lists
BREVO_LIST_ID=3

# ── Contact Form ──────────────────────────────────────────────────────────────
# Admin email address that receives contact form submissions
ADMIN_EMAIL=your-email@gmail.com
# Optional CC email for contact form (can be a brand contact@ address)
CONTACT_CC_EMAIL=contact@locitra.com

# ── Bot Protection (Cloudflare Turnstile) — Future ────────────────────────────
# Get keys at: https://dash.cloudflare.com/turnstile
# Turnstile is free and provides frictionless bot protection
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_site_key_here
TURNSTILE_SECRET_KEY=your_secret_key_here

# ── Rate Limiting (Upstash Redis) — Future ────────────────────────────────────
# Get credentials at: https://console.upstash.com/
# Use the REST URL and token from your Redis database settings
UPSTASH_REDIS_REST_URL=https://your-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# ── Comments (Giscus) — Optional ─────────────────────────────────────────────
# visit https://giscus.app to get your Giscus ids
NEXT_PUBLIC_GISCUS_REPO=
NEXT_PUBLIC_GISCUS_REPOSITORY_ID=
NEXT_PUBLIC_GISCUS_CATEGORY=
NEXT_PUBLIC_GISCUS_CATEGORY_ID=
# ── Technical SEO Database ───────────────────────────────────────────────────
# Neon Postgres connection string for server-side Technical SEO scan jobs.
DATABASE_URL=postgresql://username:password@host/neondb?sslmode=require

# ── Inngest Background Jobs ───────────────────────────────────────────────────
# Set INNGEST_DEV=1 for the local Inngest Dev Server.
INNGEST_DEV=1
# Production Inngest credentials are added in the hosting environment.
INNGEST_EVENT_KEY=your_inngest_event_key_here
INNGEST_SIGNING_KEY=your_inngest_signing_key_here

# ── Stripe Test Mode ─────────────────────────────────────────────────────────
# Server-only Stripe secret key (never expose to the browser).
STRIPE_SECRET_KEY=sk_test_your_key_here
# Test-mode Price ID for Targeted Technical SEO Troubleshoot ($49 USD).
STRIPE_QUICK_PRICE_ID=price_1UHFMYKNYqyFDGgbm3xXhwkS
# Webhook signing secret; use the value printed by Stripe CLI locally.
STRIPE_WEBHOOK_SECRET=whsec_your_test_webhook_secret_here

# ── PayPal Payments ──────────────────────────────────────────────────────────
# Environment: 'sandbox' for testing, 'live' for production (defaults to sandbox)
PAYPAL_ENVIRONMENT=sandbox
# REST App Client ID from PayPal Developer Dashboard
PAYPAL_CLIENT_ID=your_paypal_client_id_here
# REST App Client Secret (server-only, never expose to the browser)
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here
